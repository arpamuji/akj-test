generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Submission {
  id              Int      @id @default(autoincrement())
  fullName        String
  targetRole      String
  yearsExperience Int
  skills          String
  shortBio        String
  location        String
  preferredWorkType String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
