generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  engineType = "client"
  runtime = "bun"
}

datasource db {
  provider = "sqlite"
}

model Submission {
  id              String   @id @default(uuid())
  fullName        String
  targetRole      String
  yearsExperience Int
  skills          String @default("")
  shortBio        String
  location        String
  preferredWorkType String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
